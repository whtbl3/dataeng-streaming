      "row": 1,
      "col": 2,
      "attributes": [
        {
          "name": "depot_id",
          "type": "varchar",
          "key": [
            "pk",
            "fk"
          ],
          "references": "dim_depot.depot_id"
        },
        {
          "name": "local_date",
          "type": "date",
          "key": [
            "pk",
            "fk"
