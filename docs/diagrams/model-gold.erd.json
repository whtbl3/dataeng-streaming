          "key": "fk",
          "references": "dim_van.van_key"
        },
        {
          "name": "promised_start",
          "type": "timestamptz(6)"
        },
        {
          "name": "promised_end",
          "type": "timestamptz(6)"
        },
        {
          "name": "closed_at",
          "type": "timestamptz(6)"
        },
        {
          "name": "outcome",
          "type": "varchar"
        },
        {
