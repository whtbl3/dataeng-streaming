      "row": 2,
      "col": 2,
      "attributes": [
        {
          "name": "local_date",
          "type": "date",
          "key": [
            "pk",
            "fk"
          ],
          "references": "dim_date.local_date"
        },
        {
          "name": "late_after_close",
          "type": "bigint"
        }
      ]
    }
