  "relationships": [
    {
      "id": "r-f-van",
      "from": "fct_delivery",
      "to": "dim_van",
      "fromCardinality": "many",
      "toCardinality": "one",
      "label": "version as of closed_at"
    },
    {
      "id": "r-f-depot",
      "from": "fct_delivery",
      "to": "dim_depot",
      "fromCardinality": "many",
      "toCardinality": "one",
      "label": "depot"
    },
    {
      "id": "r-f-date",
      "from": "fct_delivery",
      "to": "dim_date",
      "fromCardinality": "many",
      "toCardinality": "one",
      "label": "local day"
    },
    {
      "id": "r-a-depot",
      "from": "agg_depot_daily",
      "to": "dim_depot",
      "fromCardinality": "many",
      "toCardinality": "one",
      "label": "depot"
    },
    {
      "id": "r-a-date",
      "from": "agg_depot_daily",
      "to": "dim_date",
      "fromCardinality": "many",
      "toCardinality": "one",
      "label": "day"
    },
    {
      "id": "r-c-date",
      "from": "closed_days",
      "to": "dim_date",
      "fromCardinality": "one",
      "toCardinality": "one",
      "toOptional": false,
      "fromOptional": true,
      "label": "closed"
    }
  ],
  "cards": [
    {
      "dot": "amber",
      "title": "Planned, not built",
      "items": [
        "Tables, keys and fct_delivery columns follow docs/requirements.md section 4",
        "Other columns and all types are a draft until the feature 7 spec"
      ]
    },
    {
      "dot": "emerald",
      "title": "Why a star schema",
      "items": [
        "KPIs slice one fact by depot, van and day with simple joins",
        "dim_van is SCD Type 2, so a van that changes depot does not rewrite history",
        "is_final separates provisional (every 5 min) from final rows (nightly close)"
      ]
    }
  ]
}
