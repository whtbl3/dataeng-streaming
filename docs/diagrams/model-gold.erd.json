        },
        {
          "name": "valid_from",
          "type": "timestamptz(6)"
        },
        {
          "name": "valid_to",
          "type": "timestamptz(6)"
        }
      ]
    },
    {
      "id": "dim_depot",
      "label": "gold.dim_depot",
      "sublabel": "one row per depot",
      "tag": "dimensions",
      "row": 1,
      "col": 1,
      "attributes": [
        {
          "name": "depot_id",
          "type": "varchar",
          "key": "pk"
        },
        {
          "name": "name",
          "type": "varchar"
        },
        {
          "name": "lat",
          "type": "double"
        },
        {
          "name": "lon",
          "type": "double"
        }
      ]
    },
    {
      "id": "dim_date",
      "label": "gold.dim_date",
      "sublabel": "local day, Asia/Ho_Chi_Minh",
