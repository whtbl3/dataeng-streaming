{
  "schema_version": 1,
  "diagram_type": "erd",
  "meta": {
    "title": "Gold star schema (planned, feature 7)",
    "locale": "en",
    "output": "docs/diagrams/model-gold.html",
    "quality_profile": "showcase"
  },
  "layout": {
    "mode": "grid",
    "gapX": 96,
    "gapY": 40
  },
  "entities": [
