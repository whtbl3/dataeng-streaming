# AWS lakehouse settings (spec 009, ADR 0015): S3 + Glue Data Catalog + Athena.
# Copy to infra/aws/lakehouse.env (gitignored) and replace <bucket> and <optimizer-role-arn>
# with the outputs of `make aws-lake-up`. No credentials go here: they come from your AWS login
# (`aws sso login`) as short-lived environment variables (`make up LAKEHOUSE=aws`).
#
# The local counterpart is infra/local/lakehouse.env; the jobs, table definitions and models are
# the same files in both cases.

AWS_REGION=ap-southeast-1

# Flink Iceberg catalog options: Glue instead of the REST catalog, S3 instead of MinIO
ICEBERG_CATALOG_OPTIONS="'catalog-impl' = 'org.apache.iceberg.aws.glue.GlueCatalog', 'warehouse' = 's3://<bucket>/warehouse/', 'io-impl' = 'org.apache.iceberg.aws.s3.S3FileIO', 'client.region' = 'ap-southeast-1'"

# pyiceberg (infra/lakehouse/tables.py)
PYICEBERG_CATALOG__LAKEHOUSE__TYPE=glue
PYICEBERG_CATALOG__LAKEHOUSE__GLUE__REGION=ap-southeast-1
PYICEBERG_CATALOG__LAKEHOUSE__S3__REGION=ap-southeast-1
PYICEBERG_CATALOG__LAKEHOUSE__WAREHOUSE=s3://<bucket>/warehouse/
# turns on the Glue table optimizers (compaction, snapshot retention, orphan files)
GLUE_OPTIMIZER_ROLE_ARN=<optimizer-role-arn>

# dbt on Athena (dbt/profiles.yml.example, target aws)
DBT_TARGET=aws
DBT_ATHENA_WORKGROUP=control-tower
DBT_ATHENA_STAGING_DIR=s3://<bucket>/athena-results/
DBT_ATHENA_DATA_DIR=s3://<bucket>/warehouse/gold/
