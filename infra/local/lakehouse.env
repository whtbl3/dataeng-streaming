# Local lakehouse settings (spec 009, ADR 0015): MinIO + Iceberg REST catalog + Trino.
# The AWS counterpart is infra/aws/lakehouse.env.example; `make up LAKEHOUSE=aws` picks that one.
# Only configuration lives here: the jobs, table definitions and models are the same files.

# Flink Iceberg catalog options (_init_catalog.sql, the silver_gps source, control_tower.py)
ICEBERG_CATALOG_OPTIONS="'catalog-type' = 'rest', 'uri' = 'http://iceberg-rest:8181', 'warehouse' = 's3://warehouse/', 'io-impl' = 'org.apache.iceberg.aws.s3.S3FileIO', 's3.endpoint' = 'http://minio:9000', 's3.path-style-access' = 'true', 's3.access-key-id' = 'ct-local', 's3.secret-access-key' = 'ct-local-secret', 'client.region' = 'us-east-1'"

# pyiceberg (infra/lakehouse/tables.py): the same catalog, as seen from inside the compose network
PYICEBERG_CATALOG__LAKEHOUSE__TYPE=rest
PYICEBERG_CATALOG__LAKEHOUSE__URI=http://iceberg-rest:8181
PYICEBERG_CATALOG__LAKEHOUSE__S3__ENDPOINT=http://minio:9000
PYICEBERG_CATALOG__LAKEHOUSE__S3__ACCESS_KEY_ID=ct-local
PYICEBERG_CATALOG__LAKEHOUSE__S3__SECRET_ACCESS_KEY=ct-local-secret
PYICEBERG_CATALOG__LAKEHOUSE__S3__PATH_STYLE_ACCESS=true
PYICEBERG_CATALOG__LAKEHOUSE__S3__REGION=us-east-1

# dbt target (dbt/profiles.yml.example)
DBT_TARGET=local
