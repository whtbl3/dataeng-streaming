# Copy to .env and fill in. Never commit .env.
# Local defaults match infra/local/docker-compose.yml.
APP_ENV=local                      # local | aws

# Kafka (Redpanda locally, MSK Serverless on AWS)
KAFKA_BOOTSTRAP=localhost:19092
SCHEMA_REGISTRY_URL=http://localhost:18081

# Postgres (orders OLTP + serving schema)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=control_tower
POSTGRES_USER=ct
POSTGRES_PASSWORD=

# Object storage + Iceberg catalog (MinIO + REST catalog locally; S3 + Glue on AWS)
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=
S3_SECRET_KEY=
ICEBERG_CATALOG_URI=http://localhost:8181
WAREHOUSE=s3://warehouse/

# Simulator
SIM_VANS=200
SIM_PING_SECONDS=5
SIM_CHAOS=false                    # true = emit late, out-of-order and duplicate events

# AWS (only for make aws-*)
AWS_REGION=ap-southeast-1
AWS_PROFILE=
