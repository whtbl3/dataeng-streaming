# Copy to .env only if you want to override defaults. Never commit .env.
# The local stack needs no .env: infra/local/docker-compose.yml has defaults for everything.
APP_ENV=local                      # local | aws

# Kafka (Redpanda locally, MSK Serverless on AWS)
KAFKA_BOOTSTRAP=localhost:19092
SCHEMA_REGISTRY_URL=http://localhost:18081
GPS_TOPIC=gps.pings.v1

# Local S3 (MinIO). Default image is a Docker Hardened Image: run `docker login dhi.io` once.
# Upstream MinIO no longer publishes images. Without a Docker account, swap the `minio`
# service for another S3-compatible server (see docs/tech-stack.md, "Local S3").
S3_IMAGE=dhi.io/minio:RELEASE.2025-09-07T16-13-09Z-debian13
S3_ACCESS_KEY=ct-local
S3_SECRET_KEY=ct-local-secret      # local-only default, not a real secret
LOCAL_S3_REGION=us-east-1
WAREHOUSE=s3://warehouse/

# Flink
CHECKPOINT_INTERVAL=30 s           # Iceberg commits on each checkpoint (bronze freshness)

# Postgres (orders OLTP, CDC source; serving schema later)
ORDERS_DSN=postgresql://ct:ct-local@localhost:15432/control_tower
POSTGRES_HOST=localhost
POSTGRES_HOST_PORT=15432          # host port (5432 is often taken by a local install)
POSTGRES_DB=control_tower
POSTGRES_USER=ct
POSTGRES_PASSWORD=ct-local        # local-only default

# Simulator (`python -m simulator day`)
SIM_VANS=20
SIM_PING_SECONDS=5

# AWS (only for make aws-*)
AWS_REGION=ap-southeast-1
AWS_PROFILE=
